{
"name": "Anti-desktop",
"version": "1.0.0",
"author": "Anti",
"description": "Desktop client for antiesocial.github.io/forum/",
"main": "src/main.js",
"scripts": {
"start": "electron .",
"dist": "electron-builder --win --publish never"
},
"build": {
"appId": "com.yourdomain.app",
"productName": "Anti",
"files": [
"src/**/*"
],
"win": {
"target": "nsis",
"icon": "src/Block.ico"
},
"nsis": {
"installerIcon": "src/Block.ico",
"uninstallerIcon": "src/Block.ico"
}
},
"devDependencies": {
"electron": "^28.0.0",
"electron-builder": "^24.0.0"
}
}

